{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polycode.local/esquemas/pedido_procesado.schema.json",
  "title": "PedidoProcesado",
  "allOf": [
    { "$ref": "pedido.schema.json" },
    {
      "type": "object",
      "required": ["estado", "prioridad", "calculos"],
      "properties": {
        "calculos": { "$ref": "#/$defs/calculos" }
      }
    }
  ],
  "$defs": {
    "calculos": {
      "type": "object",
      "required": ["subtotal", "porcentajeDescuento", "descuento", "impuesto", "costoEnvio", "total"],
      "additionalProperties": false,
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "porcentajeDescuento": { "type": "integer", "minimum": 0, "maximum": 20 },
        "descuento": { "type": "number", "minimum": 0 },
        "impuesto": { "type": "number", "minimum": 0 },
        "costoEnvio": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      }
    }
  }
}
