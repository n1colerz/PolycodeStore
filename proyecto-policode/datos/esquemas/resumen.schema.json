{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polycode.local/esquemas/resumen.schema.json",
  "title": "ResumenVentas",
  "type": "object",
  "required": ["totalPedidos", "montoTotal", "porEstado", "porPrioridad"],
  "additionalProperties": false,
  "properties": {
    "totalPedidos": { "type": "integer", "minimum": 0 },
    "montoTotal": { "type": "number", "minimum": 0 },
    "porEstado": {
      "type": "object",
      "required": ["recibido", "en_preparacion", "enviado", "entregado", "cancelado"],
      "additionalProperties": false,
      "properties": {
        "recibido": { "type": "integer", "minimum": 0 },
        "en_preparacion": { "type": "integer", "minimum": 0 },
        "enviado": { "type": "integer", "minimum": 0 },
        "entregado": { "type": "integer", "minimum": 0 },
        "cancelado": { "type": "integer", "minimum": 0 }
      }
    },
    "porPrioridad": {
      "type": "object",
      "required": ["alta", "media", "baja"],
      "additionalProperties": false,
      "properties": {
        "alta": { "type": "integer", "minimum": 0 },
        "media": { "type": "integer", "minimum": 0 },
        "baja": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
