{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polycode.local/esquemas/producto.schema.json",
  "title": "Producto",
  "type": "object",
  "required": ["codigo", "nombre", "precioUnitario", "categoria"],
  "properties": {
    "codigo": { "type": "string", "pattern": "^PROD-[0-9]{3}$" },
    "nombre": { "type": "string", "minLength": 1 },
    "precioUnitario": { "type": "number", "minimum": 0 },
    "categoria": { "type": "string", "minLength": 1 }
  }
}
